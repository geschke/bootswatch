// Kdo2 4.0.0
// Bootswatch

$theme: "kdo2" !default;

//
// Color system
//

$white:    #fff !default;
$gray-100: #f5f5f5 !default;
$gray-200: #e9e9e9 !default;
$gray-300: #e4e4e4 !default;
$gray-400: #c4c4c4 !default;
$gray-500: #a7a7a7 !default;
$gray-600: #8d8d8d !default;
$gray-700: #494949 !default;
$gray-800: #343a40 !default;
$gray-900: #272727 !default;
$black:    #000 !default;

$blue:    #007bff !default;
$indigo:  #6610f2 !default;
$purple:  #6f42c1 !default;
$pink:    #e83e8c !default;
$red:     #dc3545 !default;
$orange:  #fd7e14 !default;
$yellow:  #ffc107 !default;
$green:   #28a745 !default;
$teal:    #20c997 !default;
$cyan:    #17a2b8 !default;

$primary:       #605F5C !default;
$secondary:     #493E3A   !default;
$success:       #8C6A5A !default; // war: $green
$info:          #737B89 !default; // war: $cyan
$warning:       #B4AFA4 !default; // war: $yellow
$danger:        #d9534f !default; // war: $red;
$light:         $gray-200 !default;
$dark:          $gray-800 !default;


// Links
//
// Style anchor elements.

$link-color:                              $primary !default;
$link-decoration:                         none !default; // war: underline
$link-shade-percentage:                   20% !default;
$link-hover-color:                        shift-color($link-color, $link-shade-percentage) !default;
$link-hover-decoration:                   underline !default; // war: null

$stretched-link-pseudo-element:           after !default;
$stretched-link-z-index:                  1 !default;


$body-bg: #E0E0DC;
//////////////////////////bis hierhin ok

$colors: () !default;
$colors: map-merge((
  "blue":       $blue,
  "indigo":     $indigo,
  "purple":     $purple,
  "pink":       $pink,
  "red":        $red,
  "orange":     $orange,
  "yellow":     $yellow,
  "green":      $green,
  "teal":       $teal,
  "cyan":       $cyan,
  "white":      $white,
  "gray":       $gray-600,
  "gray-dark":  $gray-800
), $colors);

$theme-colors: () !default;
$theme-colors: map-merge((
  "primary":    $primary,
  "secondary":  $secondary,
  "success":    $success,
  "info":       $info,
  "warning":    $warning,
  "danger":     $danger,
  "light":      $light,
  "dark":       $dark
), $theme-colors);
////////////////// bis hier nicht übernommen
// Links

$link-color:   $primary !default; // war: $success

// Fonts

$font-family-sans-serif:      -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol" !default;
/*
$font-size-base:              0.9375rem !default;

$h1-font-size:                3rem !default;
$h2-font-size:                2.5rem !default;
$h3-font-size:                2rem !default;
*/

/*$line-height-base:            1.55 !default;

*/
$line-height-base:            1.6 !default;
$line-height-sm:              1.25 !default;
$line-height-lg:              2 !default;

// Tables
/*
$table-accent-bg:             $gray-200 !default;
*/
// Dropdowns
/*
$dropdown-link-color:               $gray-700 !default;
$dropdown-link-hover-color:         $white !default;
$dropdown-link-hover-bg:            $primary !default;
*/
// Navs
/*
$nav-link-padding-y:                .5rem !default !default;
$nav-link-padding-x:                2rem !default;
$nav-link-disabled-color:           $gray-600 !default !default;

$nav-tabs-border-color:             $gray-200 !default;
*/
// Navbar
/*
$navbar-padding-y:                  1rem !default;

$navbar-dark-color:                 $gray-400 !default;
$navbar-dark-hover-color:           $gray-500 !default;
$navbar-dark-active-color:          $gray-200 !default;

$navbar-light-color:                rgba($white,.5) !default;
$navbar-light-hover-color:          $white !default;
$navbar-light-active-color:         $white !default;
$navbar-light-disabled-color:       rgba($white,.3) !default;
$navbar-light-toggler-border-color: rgba($white,.1) !default;
*/


// Pagination
/*
$pagination-color:                  $white !default;
$pagination-bg:                     lighten($primary,10%) !default; // war: $success
$pagination-border-width:           0 !default;
$pagination-border-color:           transparent !default;

$pagination-hover-color:            $white !default;
$pagination-hover-bg:               darken($primary, 5%) !default; // war: darken($success, 15%)
$pagination-hover-border-color:     transparent !default;

$pagination-active-bg:              darken($primary, 5%) !default; // war: $pagination-hover-bg
$pagination-active-border-color:    transparent !default;

$pagination-disabled-color:         $gray-200 !default;
$pagination-disabled-bg:            lighten($primary, 25%) !default; // war: lighten($success, 15%)
$pagination-disabled-border-color:  transparent !default;
*/
// Jumbotron
/*
$jumbotron-bg:                      $gray-200 !default;
*/

// Progress bars
/*
$progress-height:                   10px !default;
$progress-font-size:                10px !default;
*/
// List group
/*
$list-group-hover-bg:               $gray-200 !default;

$list-group-disabled-bg:            $gray-200 !default;
*/
// Close
/*
$close-color:                       $white !default;
$close-text-shadow:                 none !default;
*/
